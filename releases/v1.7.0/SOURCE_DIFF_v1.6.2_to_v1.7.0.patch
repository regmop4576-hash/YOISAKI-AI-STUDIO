+    def test_repeated_runs_do_not_accumulate_objects(self):
+        jobs = [self.i2i(), self.req(), self.i2i(controlnet_config=base.RealDiffusersControlNet.ctl('OpenPose')), self.i2i(.4, batch_size=2)]
