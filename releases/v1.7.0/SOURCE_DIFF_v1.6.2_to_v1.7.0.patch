+        gc.collect()
+        def census():
+            objs = gc.get_objects()
+            return (sum(torch.is_tensor(o) for o in objs), sum(isinstance(o, DiffusionPipeline) for o in objs), sum(isinstance(o, torch.nn.Module) for o in objs))
