# Optional settings for YOISAKI ENGINE on CloudCompute.
# Copy to $YOISAKI_DATA_ROOT/config/yoisaki.env (default /workspace/yoisaki-data/config/yoisaki.env):
#   cp cloudcompute/yoisaki.env.example /workspace/yoisaki-data/config/yoisaki.env
#   chmod 600 /workspace/yoisaki-data/config/yoisaki.env
# KEY=VALUE lines only; the file is parsed, not executed. Values set in the shell take precedence.
# The data folder itself is chosen with:  export YOISAKI_DATA_ROOT=/path/on/persistent/disk

# auto | docker | native
YOISAKI_MODE=auto

# Optional warm-up: load this checkpoint (file name in models/checkpoints) with a tiny 2-step
# generation before the link is shown, so the first real job does not wait for the model load.
# Costs paid GPU seconds on every start. Empty = lazy loading on the first job (same as Colab).
YOISAKI_WARMUP_CHECKPOINT=

# 1 = never contact Hugging Face during generation (only the cache is used). Run
# ./fetch-models-cloudcompute.sh prefetch first, otherwise ControlNet / SDPose will fail offline.
YOISAKI_HF_OFFLINE=0

# glibc allocator policy of the engine worker (same as Colab, 1 = on).
YOISAKI_RAM_FIX=1

# Seconds to wait for the engine + tunnel at start.
YOISAKI_START_TIMEOUT=900

# Google Drive model sync (1.7.2). Source: My Drive/YOISAKI_DRIVE_PATH → models/{checkpoints,loras,vae}.
# Read-only for Google Drive; local models are never deleted. Token: ./drive-sync-cloudcompute.sh connect
# (or the website: Models → GOOGLE DRIVE AUTO SYNC → Подключить Google Drive). 0 = disable sync routes.
YOISAKI_DRIVE_SYNC=1
YOISAKI_DRIVE_REMOTE=yoisaki-gdrive
YOISAKI_DRIVE_PATH=YOISAKI_AI_STUDIO/models
# 1 = run the Drive sync in ./start-cloudcompute.sh BEFORE the engine/tunnel start (models ready for the first job).
YOISAKI_DRIVE_AUTOSYNC=0

# Private tokens for gated / private downloads (keep this file chmod 600; never commit it).
HF_TOKEN=
CIVITAI_TOKEN=

# Advanced, not set by default (Colab does not set it either). Example: expandable_segments:True
# PYTORCH_CUDA_ALLOC_CONF=
