# Server-side ONLY; add to Vercel environment settings, never commit values
DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require
OWNER_PASSWORD=replace-with-long-unique-passphrase
SESSION_SECRET=replace-with-random-secret-at-least-32-characters
OBJECT_STORE_ENDPOINT=https://s3.example.com
OBJECT_STORE_BUCKET=your-private-bucket
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=example-access-key
OBJECT_STORE_SECRET_KEY=example-secret-key
